---
// «Por dentro»: recorrido horizontal por las estancias. En escritorio la sección se queda fija y el
// scroll vertical la desplaza de lado (como pasear por la casa). En móvil y con movimiento reducido,
// carrusel nativo que se desliza con el dedo.
import { Picture } from 'astro:assets';
import Icono from '../Icono.astro';
import { foto } from '../../data/fotos';
import { casa } from '../../data/casa';

import { idiomaDe } from '../../i18n';

const lang = idiomaDe(Astro.currentLocale);
const T = {
	es: {
		titulo: `Alojamiento amplio para grupos de hasta ${casa.capacidad} personas`,
		intro: 'El salón-comedor de esta casa rural en Lleida es muy amplio y cuenta con chimenea, televisión, sofás de cuero y una gran mesa para comer todos juntos. Junto a este espacio está la cocina, equipada con todos los electrodomésticos necesarios para que el grupo se sienta como en casa.',
		claves: ['Chimenea', 'Cocina completa', 'Sofás de cuero', `${casa.banos} baños`],
		estancias: [
			['Salón-comedor', 'Con chimenea, televisión, sofás de cuero y una gran mesa para comer todos juntos.'],
			['Sala de estar', 'Amueblada con mesa de madera y sillones de cuero.'],
			['Recibidor y escalera', 'La entrada, con la escalera de mármol y la barandilla de forja.'],
			[`${casa.banos} cuartos de baño`, 'Totalmente equipados con lo imprescindible.'],
		],
		salida: 'Subimos a las habitaciones',
		ampliar: 'Ampliar',
	},
	ca: {
		titulo: `Allotjament ampli per a grups de fins a ${casa.capacidad} persones`,
		intro: "La sala d'estar i menjador d'aquesta casa rural de Lleida és molt àmplia i té llar de foc, televisió, sofàs de pell i una gran taula per menjar tots junts. Al costat hi ha la cuina, equipada amb tots els electrodomèstics necessaris perquè el grup se senti com a casa.",
		claves: ['Llar de foc', 'Cuina completa', 'Sofàs de pell', `${casa.banos} banys`],
		estancias: [
			["Sala d'estar i menjador", 'Amb llar de foc, televisió, sofàs de pell i una gran taula per menjar tots junts.'],
			["Sala d'estar", 'Moblada amb taula de fusta i butaques de pell.'],
			['Rebedor i escala', "L'entrada, amb l'escala de marbre i la barana de forja."],
			[`${casa.banos} banys`, 'Totalment equipats amb tot el que cal.'],
		],
		salida: 'Pugem a les habitacions',
		ampliar: 'Amplia',
	},
}[lang];
const fotosEstancias = [
	['salon-comedor-mesa', 'salon-chimenea'],
	['comedor', 'sala-estar-lampara'],
	['recibidor-escalera', 'escalera-recibidor'],
	['bano-b-lavabo', 'bano-suite'],
];
const estancias = T.estancias.map(([nombre, texto], i) => ({ nombre, texto, fotos: fotosEstancias[i].map((id) => foto(id, lang)) }));
const pasillo = foto('pasillo-habitaciones', lang);
---

<section class="por-dentro" id="espacios" aria-labelledby="por-dentro-titulo" data-por-dentro>
	<div class="pista" data-pista>
		<div class="panel panel--intro">
			<h2 id="por-dentro-titulo">{T.titulo}</h2>
			<p>{T.intro}</p>
			<ul class="claves">
				{['fire', 'cooking-pot', 'couch', 'bathtub'].map((ic, i) => <li><Icono nombre={ic} /> {T.claves[i]}</li>)}
			</ul>
		</div>

		{
			estancias.map((e, i) => (
				<figure class:list={['panel', 'estancia', { 'estancia--alterna': i % 2 === 1 }]}>
					<div class="estancia__fotos">
						<button
							class="estancia__principal arco"
							type="button"
							data-ampliar="casa"
							data-id={e.fotos[0].id}
							aria-label={`${T.ampliar}: ${e.fotos[0].alt}`}
						>
							<Picture
								formats={['avif', 'webp']}
								src={e.fotos[0].src}
								alt={e.fotos[0].alt}
								widths={[480, 800]}
								sizes="(max-width: 820px) 78vw, 30vw"
							/>
						</button>
						<button
							class="estancia__segunda"
							type="button"
							data-ampliar="casa"
							data-id={e.fotos[1].id}
							aria-label={`${T.ampliar}: ${e.fotos[1].alt}`}
						>
							<Picture
								formats={['avif', 'webp']}
								src={e.fotos[1].src}
								alt={e.fotos[1].alt}
								widths={[400, 800]}
								sizes="(max-width: 820px) 46vw, 17vw"
							/>
						</button>
					</div>
					<figcaption>
						<span class="estancia__nombre">{e.nombre}</span>
						<span class="estancia__texto">{e.texto}</span>
					</figcaption>
				</figure>
			))
		}

		<a class="panel panel--salida" href="#habitaciones">
			<span class="salida__foto arco">
				<Picture formats={['avif', 'webp']} src={pasillo.src} alt={pasillo.alt} widths={[400, 600]} sizes="(max-width: 820px) 60vw, 20vw" />
			</span>
			<span class="salida__texto">{T.salida} <Icono nombre="arrow-right" class="flecha" /></span>
		</a>
	</div>
	<div class="progreso" aria-hidden="true"><i data-progreso></i></div>
</section>

<style>
	.por-dentro {
		position: relative;
		overflow: hidden;
		background: var(--cal-2);
	}
	.pista {
		display: flex;
		align-items: center;
		gap: clamp(2rem, 5vw, 6rem);
		width: max-content;
		height: 100vh;
		height: 100svh;
		min-height: 640px;
		padding: calc(var(--alto-cabecera) + var(--s-5)) var(--g) var(--s-7);
	}
	.panel {
		flex: none;
	}

	.panel--intro {
		display: grid;
		gap: var(--s-5);
		width: min(34rem, 80vw);
	}
	.panel--intro p {
		max-width: 44ch;
	}
	.claves {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--s-3) var(--s-5);
		margin: var(--s-2) 0 0;
		padding: var(--s-5) 0 0;
		border-top: var(--borde);
		list-style: none;
		font-weight: 500;
		color: var(--tinta);
	}
	.claves li {
		display: flex;
		align-items: center;
		gap: var(--s-3);
	}
	.claves :global(.icono) {
		flex: none;
		width: 24px;
		height: 24px;
		color: var(--oro-texto);
	}

	/* Estancia: foto grande en arco y otra pequeña, a distinta altura */
	.estancia {
		margin: 0;
		display: grid;
		gap: var(--s-5);
	}
	.estancia__fotos {
		position: relative;
		display: flex;
		align-items: flex-end;
		gap: var(--s-4);
	}
	.estancia--alterna .estancia__fotos {
		align-items: flex-start;
	}
	.estancia button {
		display: block;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
		overflow: hidden;
	}
	.estancia :global(img),
	.salida__foto :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms var(--ease);
	}
	.estancia button:hover :global(img),
	.panel--salida:hover :global(img) {
		transform: scale(1.04);
	}
	.estancia__principal {
		width: clamp(15rem, 27vw, 26rem);
		aspect-ratio: 4 / 5;
	}
	.estancia__segunda {
		width: clamp(9rem, 15vw, 15rem);
		aspect-ratio: 1;
	}
	figcaption {
		display: grid;
		gap: var(--s-1);
		max-width: 30rem;
	}
	.estancia__nombre {
		font: 500 var(--t-3) / 1.1 var(--f-display);
		color: var(--tinta);
	}
	.estancia__texto {
		color: var(--sec);
		max-width: 40ch;
	}

	.panel--salida {
		display: grid;
		gap: var(--s-4);
		justify-items: start;
		text-decoration: none;
		color: var(--tinta);
	}
	.salida__foto {
		display: block;
		width: clamp(11rem, 18vw, 17rem);
		aspect-ratio: 3 / 4;
	}
	.salida__texto {
		display: inline-flex;
		align-items: center;
		gap: var(--s-3);
		font: italic 500 var(--t-3) / 1.1 var(--f-display);
	}
	.salida__texto :global(.icono) {
		width: 26px;
		height: 26px;
		transition: transform var(--d-media) var(--ease);
	}
	.panel--salida:hover .salida__texto :global(.icono) {
		transform: translateX(4px);
	}

	/* Progreso del recorrido: línea dorada que avanza */
	.progreso {
		position: absolute;
		left: var(--g);
		right: var(--g);
		bottom: var(--s-6);
		height: 1.5px;
		background: var(--linea);
	}
	.progreso i {
		display: block;
		height: 100%;
		background: var(--oro-texto);
		transform-origin: left;
		transform: scaleX(0);
	}

	/* Móvil y movimiento reducido: carrusel nativo (se desliza con el dedo) */
	@media (max-width: 820px), (prefers-reduced-motion: reduce) {
		.por-dentro {
			padding-block: var(--seccion);
		}
		.pista {
			width: auto;
			height: auto;
			min-height: 0;
			padding-block: 0;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--g);
			overscroll-behavior-x: contain;
			scrollbar-width: none;
			align-items: flex-start;
		}
		.pista::-webkit-scrollbar {
			display: none;
		}
		.panel {
			scroll-snap-align: start;
		}
		.progreso {
			display: none;
		}
	}
	@media (max-width: 820px) {
		.panel--intro {
			width: 82vw;
		}
		.estancia__principal {
			width: 58vw;
		}
		.estancia__segunda {
			width: 26vw;
		}
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { reducido } from '../../scripts/movimiento';

	const seccion = document.querySelector<HTMLElement>('[data-por-dentro]');
	const pista = document.querySelector<HTMLElement>('[data-pista]');
	const progreso = document.querySelector<HTMLElement>('[data-progreso]');

	if (seccion && pista && !reducido) {
		gsap.registerPlugin(ScrollTrigger);
		const mm = gsap.matchMedia();
		// Solo en escritorio: la sección se fija y el scroll vertical la mueve en horizontal
		mm.add('(min-width: 821px)', () => {
			const distancia = () => pista.scrollWidth - window.innerWidth;
			gsap.to(pista, {
				x: () => -distancia(),
				ease: 'none',
				scrollTrigger: {
					trigger: seccion,
					start: 'top top',
					end: () => `+=${distancia()}`,
					pin: true,
					scrub: 1,
					invalidateOnRefresh: true,
					onUpdate: (st) => progreso && gsap.set(progreso, { scaleX: st.progress }),
				},
			});
		});
	}
</script>
