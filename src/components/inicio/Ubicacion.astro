---
// Dónde estamos. El mapa de Google se carga solo al pulsar (RGPD: hasta entonces Google no recibe
// nada del visitante), sobre una foto de los campos de alrededor.
import { Picture } from 'astro:assets';
import Icono from '../Icono.astro';
import { foto } from '../../data/fotos';
import { casa } from '../../data/casa';
import { ciudades } from '../../data/distancias';

import { idiomaDe } from '../../i18n';

const lang = idiomaDe(Astro.currentLocale);
const campos = foto('jardin-piscina-campos', lang);
const mapa = `https://maps.google.com/maps?q=Bellcaire%20d%27Urgell%2C%20Lleida&z=13&hl=${lang}&output=embed`;
const T = {
	es: {
		alt: 'Los campos de la llanura de Urgell vistos desde la casa', mostrar: 'Mostrar el mapa', aviso: 'Se cargará Google Maps',
		titulo: `Casa rural en ${casa.direccion.localidad}, <em>${casa.direccion.comarca}</em> (${casa.direccion.provincia})`,
		texto: "Els Porxos se encuentra en Bellcaire d'Urgell, un pueblo tranquilo de la comarca de La Noguera, en la provincia de Lleida. El punto de partida perfecto para grupos y familias que quieren descansar y descubrir la llanura de Urgell, con fácil acceso por carretera.",
		tabla: 'Distancias en coche desde la casa', llegar: 'Cómo llegar', maps: 'Ver en Google Maps',
	},
	ca: {
		alt: "Els camps de la plana d'Urgell vistos des de la casa", mostrar: 'Mostra el mapa', aviso: 'Es carregarà Google Maps',
		titulo: `Casa rural a ${casa.direccion.localidad}, <em>la ${casa.direccion.comarca.replace('La ', '')}</em> (${casa.direccion.provincia})`,
		texto: "Els Porxos és a Bellcaire d'Urgell, un poble tranquil de la comarca de la Noguera, a la província de Lleida. El punt de partida perfecte per a grups i famílies que volen descansar i descobrir la plana d'Urgell, amb accés fàcil per carretera.",
		tabla: 'Distàncies en cotxe des de la casa', llegar: 'Com arribar-hi', maps: 'Mira-ho a Google Maps',
	},
}[lang];
const comoLlegar = 'https://www.google.com/maps/dir/?api=1&destination=Bellcaire+d%27Urgell,+Lleida';
const verEnMaps = 'https://www.google.com/maps/search/?api=1&query=Bellcaire+d%27Urgell+Lleida';
---

<section class="ubicacion" id="ubicacion" aria-labelledby="ubicacion-titulo">
	<div class="envoltorio rejilla">
		<div class="mapa arco aparece" data-mapa={mapa}>
			<Picture formats={['avif', 'webp']} src={campos.src} alt={T.alt} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 45vw" />
			<button class="btn btn--claro mapa__boton" type="button" data-mapa-cargar>
				<Icono nombre="map-pin" /> {T.mostrar}
			</button>
			<p class="mapa__aviso">{T.aviso}</p>
		</div>
		<div class="texto">
			<h2 id="ubicacion-titulo" class="aparece" set:html={T.titulo} />
			<p class="aparece">{T.texto}</p>
			<table class="distancias aparece">
				<caption>{T.tabla}</caption>
				<tbody>
					{ciudades.map((c) => <tr><th scope="row">{lang === 'ca' ? (c.nombreCa ?? c.nombre) : c.nombre}</th><td>{c.km} km</td><td>{c.tiempo}</td></tr>)}
				</tbody>
			</table>
			<div class="acciones aparece">
				<a class="btn" href={comoLlegar} target="_blank" rel="noopener"><Icono nombre="navigation-arrow" /> {T.llegar}</a>
				<a class="btn btn--linea" href={verEnMaps} target="_blank" rel="noopener">{T.maps}</a>
			</div>
		</div>
	</div>
</section>

<style>
	.ubicacion {
		padding-block: var(--seccion);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(2.5rem, 7vw, 8rem);
		align-items: center;
	}
	.mapa {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 4.6;
		background: var(--linea);
	}
	.mapa > :global(picture) {
		position: absolute;
		inset: 0;
	}
	.mapa :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.mapa::after {
		content: '';
		position: absolute;
		inset: 0;
		background: color-mix(in oklch, var(--carbon) 28%, transparent);
		pointer-events: none;
	}
	.mapa.cargado::after {
		display: none;
	}
	.mapa__boton,
	.mapa__aviso {
		position: relative;
		z-index: 1;
	}
	.mapa__boton {
		grid-area: 1 / 1;
	}
	.mapa__aviso {
		grid-area: 1 / 1;
		align-self: end;
		margin-bottom: var(--s-5);
		font-size: var(--t-xs);
		color: var(--cal);
		text-shadow: 0 1px 8px color-mix(in oklch, var(--carbon) 60%, transparent);
	}
	.mapa :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.texto {
		display: grid;
		gap: var(--s-5);
	}
	h2 {
		max-width: 16ch;
		padding-bottom: 0.08em;
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		margin-top: var(--s-2);
	}
	.distancias {
		width: 100%;
		max-width: 30rem;
		border-collapse: collapse;
		font-size: var(--t-sm);
	}
	.distancias caption {
		text-align: left;
		padding-bottom: var(--s-2);
		font-weight: 600;
		color: var(--tinta);
	}
	.distancias th,
	.distancias td {
		padding: 0.45rem 0;
		border-bottom: var(--borde);
		text-align: left;
		font-weight: 400;
	}
	.distancias td {
		text-align: right;
		color: var(--sec);
		font-variant-numeric: tabular-nums;
		padding-left: var(--s-4);
	}
	.distancias th {
		color: var(--tinta);
	}
	@media (max-width: 820px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
		.mapa {
			order: 2;
			aspect-ratio: 4 / 4;
		}
	}
</style>

<script>
	const caja = document.querySelector<HTMLElement>('[data-mapa]');
	caja?.querySelector('[data-mapa-cargar]')?.addEventListener('click', () => {
		const iframe = document.createElement('iframe');
		iframe.src = caja.dataset.mapa!;
		iframe.title = "Mapa de Bellcaire d'Urgell";
		iframe.loading = 'lazy';
		iframe.referrerPolicy = 'no-referrer-when-downgrade';
		caja.querySelectorAll('button, p').forEach((el) => el.remove());
		caja.classList.add('cargado');
		caja.append(iframe);
		iframe.focus();
	});
</script>
