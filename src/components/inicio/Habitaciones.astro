---
// Habitaciones: el texto queda fijo a la izquierda mientras pasan las seis habitaciones,
// en dos columnas desplazadas. Cada foto se amplía al pulsarla (visor común de la página).
import { Picture } from 'astro:assets';
import { foto } from '../../data/fotos';
import { casa } from '../../data/casa';

// Tipos y textos de la web actual
const habitaciones = [
	{ nombre: 'Suite de matrimonio', texto: 'Espaciosa y luminosa, con baño en la habitación.', foto: 'habitacion-d-suite' },
	{ nombre: 'Habitación de matrimonio', texto: 'Espaciosa y luminosa, pensada para las parejas.', foto: 'habitacion-e-matrimonio' },
	{ nombre: 'Habitación doble', texto: 'Con camas individuales, perfecta para niños o amigos.', foto: 'habitacion-c-doble' },
	{ nombre: 'Habitación doble', texto: 'Con camas individuales, perfecta para niños o amigos.', foto: 'habitacion-f-doble' },
	{ nombre: 'Habitación triple', texto: 'Ideal para una pequeña familia o tres amigos.', foto: 'habitacion-a-triple' },
	{ nombre: 'Habitación séxtuple', texto: 'Con literas: la favorita de los más pequeños de la casa.', foto: 'habitacion-b-literas' },
].map((h) => ({ ...h, foto: foto(h.foto) }));
---

<section class="habitaciones" id="habitaciones" aria-labelledby="habitaciones-titulo">
	<div class="envoltorio rejilla">
		<div class="lateral">
			<div class="lateral__fijo">
				<h2 id="habitaciones-titulo" class="aparece">{casa.habitaciones} habitaciones para familias y <em>grupos</em></h2>
				<p class="aparece">
					Nuestra casa rural en Lleida tiene habitaciones para todas las combinaciones: parejas, familias con niños y
					grupos grandes de amigos. Capacidad total de {casa.capacidad} plazas.
				</p>
				<dl class="resumen aparece">
					<div><dt>2</dt><dd>de matrimonio</dd></div>
					<div><dt>2</dt><dd>dobles</dd></div>
					<div><dt>1</dt><dd>triple</dd></div>
					<div><dt>1</dt><dd>séxtuple</dd></div>
				</dl>
				<p class="nota aparece">
					Los {casa.banos} cuartos de baño están totalmente equipados con lo imprescindible para que no te falte de nada en
					ningún momento.
				</p>
				<a class="btn btn--linea aparece" href="/casa-rural-grupos-grandes/">Casa rural para grupos grandes</a>
			</div>
		</div>

		<ul class="lista">
			{
				habitaciones.map((h) => (
					<li class="habitacion aparece">
						<button class="habitacion__foto arco" type="button" data-ampliar="casa" data-id={h.foto.id} aria-label={`Ampliar: ${h.foto.alt}`}>
							<Picture formats={['avif', 'webp']} src={h.foto.src} alt={h.foto.alt} widths={[400, 640, 800]} sizes="(max-width: 820px) 46vw, 24vw" />
						</button>
						<h3>{h.nombre}</h3>
						<p>{h.texto}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.habitaciones {
		padding-block: var(--seccion);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
	}
	/* La columna ocupa todo el alto de la lista: así el texto tiene recorrido para quedarse fijo */
	.lateral {
		align-self: stretch;
	}
	.lateral__fijo {
		position: sticky;
		top: calc(var(--alto-cabecera) + var(--s-7));
		display: grid;
		gap: var(--s-5);
	}
	h2 {
		max-width: 12ch;
		padding-bottom: 0.08em;
	}
	.resumen {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		gap: var(--s-5);
		margin: 0;
		padding-block: var(--s-5);
		border-block: var(--borde);
	}
	.resumen dt {
		font: 500 var(--t-2) / 1 var(--f-display);
		color: var(--oro-texto);
	}
	.resumen dd {
		margin: var(--s-1) 0 0;
		font-size: var(--t-sm);
		color: var(--sec);
	}
	.nota {
		font-size: var(--t-sm);
		color: var(--sec);
	}

	.lista {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2.5rem, 5vw, 5rem) clamp(1.2rem, 3vw, 3rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Segunda columna desplazada hacia abajo: ritmo de galería, no de cuadrícula */
	.habitacion:nth-child(even) {
		transform: translateY(32%);
	}
	:global(.con-movimiento) .habitacion:nth-child(even).aparece {
		transform: translateY(calc(32% + 28px));
	}
	:global(.con-movimiento) .habitacion:nth-child(even).aparece.visible {
		transform: translateY(32%);
	}
	.lista {
		padding-bottom: 14%;
	}
	.habitacion {
		display: grid;
		gap: var(--s-2);
	}
	.habitacion__foto {
		display: block;
		margin-bottom: var(--s-3);
		padding: 0;
		border: 0;
		background: none;
		aspect-ratio: 4 / 5;
		cursor: zoom-in;
	}
	.habitacion__foto :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms var(--ease);
	}
	.habitacion__foto:hover :global(img) {
		transform: scale(1.04);
	}
	.habitacion p {
		font-size: var(--t-sm);
		color: var(--sec);
	}

	@media (max-width: 820px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
		.lateral__fijo {
			position: static;
		}
		.resumen {
			grid-template-columns: repeat(2, auto);
		}
		.lista {
			gap: var(--s-7) var(--s-4);
		}
	}
</style>
