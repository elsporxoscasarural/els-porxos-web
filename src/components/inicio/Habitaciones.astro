---
// Habitaciones: el texto queda fijo a la izquierda mientras pasan las seis habitaciones,
// en dos columnas desplazadas. Cada foto se amplía al pulsarla (visor común de la página).
import { Picture } from 'astro:assets';
import { foto } from '../../data/fotos';
import { casa } from '../../data/casa';

import { idiomaDe, ruta } from '../../i18n';

const lang = idiomaDe(Astro.currentLocale);
const T = {
	es: {
		titulo: `${casa.habitaciones} habitaciones para familias y <em>grupos</em>`,
		intro: `Nuestra casa rural en Lleida tiene habitaciones para todas las combinaciones: parejas, familias con niños y grupos grandes de amigos. Capacidad total de ${casa.capacidad} plazas.`,
		resumen: ['de matrimonio', 'dobles', 'triple', 'séxtuple'],
		nota: `Los ${casa.banos} cuartos de baño están totalmente equipados con lo imprescindible para que no te falte de nada en ningún momento.`,
		enlace: 'Casa rural para grupos grandes',
		ampliar: 'Ampliar',
		lista: [
			['Suite de matrimonio', 'Espaciosa y luminosa, con baño en la habitación.'],
			['Habitación de matrimonio', 'Espaciosa y luminosa, pensada para las parejas.'],
			['Habitación doble', 'Con camas individuales, perfecta para niños o amigos.'],
			['Habitación doble', 'Con camas individuales, perfecta para niños o amigos.'],
			['Habitación triple', 'Ideal para una pequeña familia o tres amigos.'],
			['Habitación séxtuple', 'Con literas: la favorita de los más pequeños de la casa.'],
		],
	},
	ca: {
		titulo: `${casa.habitaciones} habitacions per a famílies i <em>grups</em>`,
		intro: `La nostra casa rural de Lleida té habitacions per a totes les combinacions: parelles, famílies amb nens i grups grans d'amics. Capacitat total de ${casa.capacidad} places.`,
		resumen: ['de matrimoni', 'dobles', 'triple', 'sèxtuple'],
		nota: `Els ${casa.banos} banys estan totalment equipats amb tot el que cal perquè no et falti res en cap moment.`,
		enlace: 'Casa rural per a grups grans',
		ampliar: 'Amplia',
		lista: [
			['Suite de matrimoni', 'Espaiosa i lluminosa, amb bany a l\'habitació.'],
			['Habitació de matrimoni', 'Espaiosa i lluminosa, pensada per a les parelles.'],
			['Habitació doble', 'Amb llits individuals, perfecta per a nens o amics.'],
			['Habitació doble', 'Amb llits individuals, perfecta per a nens o amics.'],
			['Habitació triple', 'Ideal per a una família petita o tres amics.'],
			['Habitació sèxtuple', 'Amb lliteres: la preferida dels més petits de la casa.'],
		],
	},
}[lang];
const idsFotos = ['habitacion-d-suite', 'habitacion-e-matrimonio', 'habitacion-c-doble', 'habitacion-f-doble', 'habitacion-a-triple', 'habitacion-b-literas'];
const habitaciones = T.lista.map(([nombre, texto], i) => ({ nombre, texto, foto: foto(idsFotos[i], lang) }));
---

<section class="habitaciones" id="habitaciones" aria-labelledby="habitaciones-titulo">
	<div class="envoltorio rejilla">
		<div class="lateral">
			<div class="lateral__fijo">
				<h2 id="habitaciones-titulo" class="aparece" set:html={T.titulo} />
				<p class="aparece">{T.intro}</p>
				<dl class="resumen aparece">
					{['2', '2', '1', '1'].map((n, i) => <div><dt>{n}</dt><dd>{T.resumen[i]}</dd></div>)}
				</dl>
				<p class="nota aparece">{T.nota}</p>
				<a class="btn btn--linea aparece" href={ruta('/casa-rural-grupos-grandes/', lang)}>{T.enlace}</a>
			</div>
		</div>

		<ul class="lista">
			{
				habitaciones.map((h) => (
					<li class="habitacion aparece">
						<button class="habitacion__foto arco" type="button" data-ampliar="casa" data-id={h.foto.id} aria-label={`${T.ampliar}: ${h.foto.alt}`}>
							<Picture formats={['avif', 'webp']} src={h.foto.src} alt={h.foto.alt} widths={[400, 640, 800]} sizes="(max-width: 820px) 46vw, 24vw" />
						</button>
						<h3>{h.nombre}</h3>
						<p>{h.texto}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.habitaciones {
		padding-block: var(--seccion);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
	}
	/* La columna ocupa todo el alto de la lista: así el texto tiene recorrido para quedarse fijo */
	.lateral {
		align-self: stretch;
	}
	.lateral__fijo {
		position: sticky;
		top: calc(var(--alto-cabecera) + var(--s-7));
		display: grid;
		gap: var(--s-5);
	}
	h2 {
		max-width: 12ch;
		padding-bottom: 0.08em;
	}
	.resumen {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		gap: var(--s-5);
		margin: 0;
		padding-block: var(--s-5);
		border-block: var(--borde);
	}
	.resumen dt {
		font: 500 var(--t-2) / 1 var(--f-display);
		color: var(--oro-texto);
	}
	.resumen dd {
		margin: var(--s-1) 0 0;
		font-size: var(--t-sm);
		color: var(--sec);
	}
	.nota {
		font-size: var(--t-sm);
		color: var(--sec);
	}

	.lista {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2.5rem, 5vw, 5rem) clamp(1.2rem, 3vw, 3rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Segunda columna desplazada hacia abajo: ritmo de galería, no de cuadrícula */
	.habitacion:nth-child(even) {
		transform: translateY(32%);
	}
	:global(.con-movimiento) .habitacion:nth-child(even).aparece {
		transform: translateY(calc(32% + 28px));
	}
	:global(.con-movimiento) .habitacion:nth-child(even).aparece.visible {
		transform: translateY(32%);
	}
	.lista {
		padding-bottom: 14%;
	}
	.habitacion {
		display: grid;
		gap: var(--s-2);
	}
	.habitacion__foto {
		display: block;
		margin-bottom: var(--s-3);
		padding: 0;
		border: 0;
		background: none;
		aspect-ratio: 4 / 5;
		cursor: zoom-in;
	}
	.habitacion__foto :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms var(--ease);
	}
	.habitacion__foto:hover :global(img) {
		transform: scale(1.04);
	}
	.habitacion p {
		font-size: var(--t-sm);
		color: var(--sec);
	}

	@media (max-width: 820px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
		.lateral__fijo {
			position: static;
		}
		.resumen {
			grid-template-columns: repeat(2, auto);
		}
		.lista {
			gap: var(--s-7) var(--s-4);
		}
	}
</style>
