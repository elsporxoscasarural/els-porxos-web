---
// Resumen citable: una definición de la casa con datos concretos, al principio de la página.
// Es el bloque que un buscador de IA puede citar tal cual (GEO), y la respuesta rápida para quien compara.
import { casa } from '../../data/casa';
import { idiomaDe } from '../../i18n';

const lang = idiomaDe(Astro.currentLocale);
const d = casa.direccion;
const T = {
	es: {
		titulo: 'Els Porxos en datos',
		definicion: `<strong>Els Porxos</strong> es una casa rural de alquiler íntegro en ${d.localidad} (${d.comarca}, ${d.provincia}) para grupos y familias de hasta ${casa.capacidad} personas, con piscina privada, jardín vallado, barbacoa bajo el porche, zona de juegos y pista deportiva. A 35 minutos de Lleida y una hora y media de Barcelona.`,
		datos: ['personas como máximo', 'habitaciones', 'baños completos', 'plantas', 'piscina privada', 'pista deportiva'],
	},
	ca: {
		titulo: 'Els Porxos en dades',
		definicion: `<strong>Els Porxos</strong> és una casa rural de lloguer íntegre a ${d.localidad} (${d.comarca.replace('La ', 'la ')}, ${d.provincia}) per a grups i famílies de fins a ${casa.capacidad} persones, amb piscina privada, jardí tancat, barbacoa sota el porxo, zona de jocs i pista esportiva. A 35 minuts de Lleida i una hora i mitja de Barcelona.`,
		datos: ['persones com a màxim', 'habitacions', 'banys complets', 'plantes', 'piscina privada', 'pista esportiva'],
	},
}[lang];
const cifras = [String(casa.capacidad), String(casa.habitaciones), String(casa.banos), '2', '1', '1'];
const datos = cifras.map((cifra, i) => ({ cifra, texto: T.datos[i] }));
---

<section class="resumen" aria-labelledby="resumen-titulo">
	<div class="envoltorio rejilla">
		<h2 id="resumen-titulo" class="visualmente-oculto">{T.titulo}</h2>
		<p class="definicion aparece" set:html={T.definicion} />
		<dl class="datos">
			{
				datos.map((d) => (
					<div class="aparece">
						<dt>{d.cifra}</dt>
						<dd>{d.texto}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.resumen {
		padding-block: clamp(3.5rem, 7vw, 6rem);
		border-bottom: var(--borde);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
	}
	.definicion {
		max-width: 34ch;
		font: 400 clamp(1.35rem, 2.1vw, 1.9rem) / 1.35 var(--f-display);
		color: var(--tinta);
	}
	.definicion strong {
		font-weight: 600;
	}
	.datos {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin: 0;
		border-top: var(--borde);
	}
	.datos div {
		padding: var(--s-4) var(--s-3) var(--s-4) 0;
		border-bottom: var(--borde);
	}
	.datos dt {
		font: 500 clamp(1.8rem, 3vw, 2.6rem) / 1 var(--f-display);
		color: var(--oro-texto);
	}
	.datos dd {
		margin: var(--s-1) 0 0;
		font-size: var(--t-sm);
		color: var(--sec);
	}
	@media (max-width: 860px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 420px) {
		.datos {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
