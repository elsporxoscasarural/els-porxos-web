---
// Portada: la casa vista dentro de un arco y, al hacer scroll, el arco se abre y entras al porche.
// Sin JS o con «reducir movimiento», las dos escenas se ven una debajo de otra, estáticas y completas.
import { Picture } from 'astro:assets';
import Icono from '../Icono.astro';
import { casa } from '../../data/casa';
import fachada from '../../assets/img/casa/casa-dron.jpg';
import porche from '../../assets/img/casa/porche-futbolin-piscina.jpg';

const numeros = ['cero', 'una', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve'];
const texto = (n: number) => (n < numeros.length ? numeros[n] : String(n));
const mayuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<section class="secuencia" aria-label="Portada" data-secuencia>
	<div class="escena">
		<div class="inicio">
			<div class="capa fachada" data-fachada>
				<Picture
					formats={['avif', 'webp']}
					src={fachada}
					alt="Vista aérea de la casa rural Els Porxos con su jardín y la piscina, entre los campos de Bellcaire d'Urgell"
					widths={[800, 1200, 1600, 2000]}
					sizes="100vw"
					loading="eager"
					fetchpriority="high"
				/>
			</div>

			<div class="portada">
				<p class="origen entra">
					<span class="origen__arco" aria-hidden="true"></span>
					{casa.direccion.localidad}, {casa.direccion.provincia}
				</p>
				<h1 class="entra">Casa rural para <em>grupos</em> en Lleida</h1>
				<p class="sub entra">
					Hasta {casa.capacidad} personas, piscina privada y porches con arcos en {casa.direccion.localidad}. La casa
					entera, solo para vosotros.
				</p>
				<div class="acciones entra">
					<a class="btn" href={casa.whatsapp} target="_blank" rel="noopener">
						<Icono nombre="whatsapp-logo" />
						Reservar
					</a>
					<a class="btn btn--linea" href="#la-casa">Ver la casa</a>
				</div>
			</div>
		</div>

		<div class="capa porche" data-porche>
			<Picture
				formats={['avif', 'webp']}
				src={porche}
				alt="El porche bajo los arcos con el futbolín, el jardín y la piscina al fondo"
				widths={[960, 1440, 1920, 2560]}
				sizes="100vw"
			/>
			<div class="velo" data-velo aria-hidden="true"></div>
			<p class="dentro">
				<span class="linea">{mayuscula(texto(casa.habitaciones))} habitaciones y {texto(casa.banos)} baños.</span>
				<span class="linea">Piscina privada y jardín.</span>
				<span class="linea">Porches para comer todos juntos.</span>
				<span class="linea"><em>Hasta {casa.capacidad} personas.</em></span>
			</p>
		</div>
	</div>
</section>

<style>
	/* ---------- Disposición estática (sin JS o con movimiento reducido) ---------- */
	.secuencia {
		position: relative;
		background: var(--cal);
	}
	.inicio {
		position: relative;
		height: 100vh;
		height: 100svh;
		min-height: 620px;
		overflow: hidden;
	}
	.capa :global(picture),
	.capa :global(img) {
		width: 100%;
		height: 100%;
	}
	.capa :global(img) {
		object-fit: cover;
	}

	/* La casa, dentro de un arco a la derecha. La capa se desplaza para que en el arco
	   se vean los porches y el balcón (y no solo el magnolio); al abrirse vuelve a su sitio. */
	.fachada {
		--desp: 26vw;
		--arriba: calc(var(--alto-cabecera) + 2.5vh);
		position: absolute;
		inset: 0;
		transform: translateX(var(--desp));
		clip-path: inset(var(--arriba) 30vw 0 24vw round 23vw 23vw 0 0);
		will-change: transform, clip-path;
	}
	.fachada :global(img) {
		object-position: 50% 55%;
	}
	/* Foto de dron: se acerca a la casa y la piscina (fuera la carretera y los vecinos) */
	.fachada :global(picture) {
		display: block;
		transform: scale(1.5);
		transform-origin: 53% 50%;
	}

	.portada {
		position: absolute;
		inset: 0 auto 0 0;
		z-index: 2;
		width: 48vw;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--s-5);
		padding: calc(var(--alto-cabecera) + var(--s-6)) var(--s-7) var(--s-7) var(--g);
	}
	h1 {
		max-width: 15ch;
		padding-bottom: 0.08em; /* margen para las descendentes de la cursiva (g, p) */
	}
	.sub {
		max-width: 38ch;
		font-size: var(--t-lead);
		color: var(--texto);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		margin-top: var(--s-2);
	}

	/* «Bellcaire d'Urgell, Lleida» con un pequeño arco dorado delante */
	.origen {
		display: flex;
		align-items: center;
		gap: var(--s-3);
		font-size: var(--t-sm);
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--oro-texto);
	}
	.origen__arco {
		flex: none;
		width: 14px;
		height: 18px;
		border: 1.5px solid var(--oro);
		border-bottom: 0;
		border-radius: 999px 999px 0 0;
	}

	/* El porche: en estático, una segunda pantalla debajo */
	.porche {
		position: relative;
		height: 100vh;
		height: 100svh;
		min-height: 560px;
		overflow: hidden;
	}
	.porche :global(img) {
		object-position: 50% 55%;
	}
	.velo {
		position: absolute;
		inset: 0;
		/* Más oscuro abajo a la izquierda, donde va el texto; la piscina y el jardín quedan limpios */
		background:
			linear-gradient(90deg, color-mix(in oklch, var(--carbon) 42%, transparent) 0%, transparent 62%),
			linear-gradient(
				180deg,
				color-mix(in oklch, var(--carbon) 6%, transparent) 0%,
				color-mix(in oklch, var(--carbon) 22%, transparent) 45%,
				color-mix(in oklch, var(--carbon) 76%, transparent) 100%
			);
	}
	.dentro {
		position: absolute;
		left: var(--g);
		bottom: clamp(2.5rem, 8vh, 5.5rem);
		z-index: 2;
		max-width: none;
		display: grid;
		gap: 0.1em;
		font: 500 var(--t-2) / 1.12 var(--f-display);
		color: var(--cal);
		text-shadow: 0 1px 24px color-mix(in oklch, var(--carbon) 40%, transparent);
	}
	.dentro em {
		font-style: italic;
		color: var(--oro);
	}
	.linea {
		display: block;
	}

	/* ---------- Con movimiento: las dos escenas se superponen en una pantalla fija ---------- */
	:global(.con-movimiento) .secuencia {
		height: 330vh;
	}
	:global(.con-movimiento) .escena {
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100svh;
		min-height: 620px;
		overflow: hidden;
	}
	:global(.con-movimiento) .inicio,
	:global(.con-movimiento) .porche {
		position: absolute;
		inset: 0;
		height: auto;
		min-height: 0;
	}
	/* En reposo el porche está oculto: se abre desde un arco pequeño, abajo en el centro */
	:global(.con-movimiento) .porche {
		z-index: 3;
		visibility: hidden;
		will-change: clip-path;
	}
	:global(.con-movimiento) .velo,
	:global(.con-movimiento) .linea {
		opacity: 0;
	}

	/* Entrada al cargar: el texto sube y la foto se asienta */
	@media (prefers-reduced-motion: no-preference) {
		.entra {
			animation: subir 1s var(--ease) both;
		}
		.entra:nth-child(2) {
			animation-delay: 80ms;
		}
		.entra:nth-child(3) {
			animation-delay: 180ms;
		}
		.entra:nth-child(4) {
			animation-delay: 280ms;
		}
		.fachada :global(img) {
			animation: asentar 1.8s var(--ease) both;
		}
	}
	@keyframes subir {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
	}
	@keyframes asentar {
		from {
			transform: scale(1.08);
		}
	}

	/* ---------- Móvil: texto arriba y la casa en un arco abajo ---------- */
	@media (max-width: 820px) {
		.inicio {
			min-height: 640px;
		}
		/* La capa baja 18vh: en el arco (mitad inferior de la pantalla) se ven el balcón y los arcos del porche */
		.fachada {
			transform: translateY(18vh);
			clip-path: inset(34vh 5vw 18vh 5vw round 45vw 45vw 0 0);
		}
		.fachada :global(img) {
			object-position: 52% 50%;
		}
		.portada {
			inset: 0 0 auto 0;
			width: auto;
			height: 52%;
			justify-content: flex-end;
			gap: var(--s-4);
			padding: calc(var(--alto-cabecera) + var(--s-4)) var(--g) var(--s-5);
		}
		h1 {
			font-size: clamp(2.5rem, 11vw, 3.4rem);
		}
		.sub {
			font-size: var(--t-base);
		}
		.dentro {
			font-size: clamp(1.6rem, 7vw, 2.2rem);
			right: var(--g);
		}
	}
	@media (max-width: 820px) and (max-height: 700px) {
		.sub {
			display: none;
		}
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { reducido } from '../../scripts/movimiento';

	if (!reducido) {
		gsap.registerPlugin(ScrollTrigger);
		const movil = () => window.matchMedia('(max-width: 820px)').matches;
		const vw = () => window.innerWidth / 100;
		const vh = () => window.innerHeight / 100;
		const cabecera = 72;

		// Recortes en px (GSAP necesita la misma estructura al principio y al final para interpolar)
		const arcoFachada = () =>
			movil()
				? `inset(${34 * vh()}px ${5 * vw()}px ${18 * vh()}px ${5 * vw()}px round ${45 * vw()}px ${45 * vw()}px 0px 0px)`
				: `inset(${cabecera + 2.5 * vh()}px ${30 * vw()}px 0px ${24 * vw()}px round ${23 * vw()}px ${23 * vw()}px 0px 0px)`;
		const arcoPorche = () =>
			movil()
				? `inset(${64 * vh()}px ${30 * vw()}px 0px ${30 * vw()}px round ${20 * vw()}px ${20 * vw()}px 0px 0px)`
				: `inset(${58 * vh()}px ${41 * vw()}px 0px ${41 * vw()}px round ${9 * vw()}px ${9 * vw()}px 0px 0px)`;
		const abierto = 'inset(0px 0px 0px 0px round 0px 0px 0px 0px)';
		// Desplazamiento de reposo de la capa de la casa (escritorio: a la derecha; móvil: hacia abajo)
		const despX = () => (movil() ? 0 : 26 * vw());
		const despY = () => (movil() ? 18 * vh() : 0);

		gsap
			.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: {
					trigger: '[data-secuencia]',
					start: 'top top',
					end: 'bottom bottom',
					scrub: 0.6,
					invalidateOnRefresh: true,
				},
			})
			// 1. El texto se retira y el arco de la casa se abre a pantalla completa
			.to('.portada', { yPercent: -14, opacity: 0, duration: 0.16 }, 0)
			.fromTo(
				'[data-fachada]',
				{ clipPath: arcoFachada, x: despX, y: despY },
				{ clipPath: abierto, x: 0, y: 0, duration: 0.3, ease: 'power2.inOut' },
				0,
			)
			.to('[data-fachada]', { scale: 1.16, duration: 0.42, ease: 'power1.in' }, 0.08)
			// 2. Entras por un arco pequeño al porche
			.set('[data-porche]', { visibility: 'visible' }, 0.28)
			.fromTo('[data-porche]', { clipPath: arcoPorche }, { clipPath: abierto, duration: 0.3, ease: 'power2.inOut' }, 0.28)
			.fromTo('[data-porche] img', { scale: 1.14 }, { scale: 1, duration: 0.46, ease: 'power2.out' }, 0.28)
			// 3. Lo que tiene la casa, línea a línea
			.to('[data-velo]', { opacity: 1, duration: 0.14 }, 0.52)
			.fromTo('.linea', { opacity: 0, y: 34 }, { opacity: 1, y: 0, stagger: 0.06, duration: 0.12, ease: 'power2.out' }, 0.58)
			.to({}, { duration: 0.14 });
	}
</script>
