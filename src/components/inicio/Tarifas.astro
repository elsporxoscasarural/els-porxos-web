---
// Tarifas: sin precios (dependen del grupo, las noches y las fechas). Las temporadas se leen
// de un vistazo en una barra con los doce meses del año.
import Icono from '../Icono.astro';
import { casa } from '../../data/casa';

import { idiomaDe } from '../../i18n';

const lang = idiomaDe(Astro.currentLocale);
const T = {
	es: {
		meses: ['E', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'],
		nombresMeses: ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'],
		temporadas: [
			['Temporada alta', 'De abril a septiembre', 'La mejor época para disfrutar de la piscina privada y el exterior.'],
			['Temporada baja', 'De octubre a marzo', 'Ideal para escapadas en grupo con chimenea y tranquilidad.'],
			['Puentes y festivos', 'Semana Santa, Navidad, puentes', 'Consulta disponibilidad con antelación, se llena rápido para grupos.'],
		],
		titulo: 'Precio del alquiler de la casa rural <em>completa</em>',
		intro: 'El alquiler de Els Porxos es siempre de la casa rural completa, con acceso exclusivo a la piscina, el jardín, la barbacoa y todas las instalaciones para tu grupo.',
		incluye: ['Mínimo 2 noches', `Hasta ${casa.capacidad} personas`, 'Sábanas y toallas incluidas', 'Limpieza final incluida'],
		reservar: 'Reservar',
		consulta: 'Enviar consulta',
		anyo: 'Temporada alta de abril a septiembre; temporada baja de octubre a marzo',
		aviso: 'Precios por noche para la casa rural completa. Consulta precios exactos para las fechas de tu grupo.',
	},
	ca: {
		meses: ['G', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'],
		nombresMeses: ['gener', 'febrer', 'març', 'abril', 'maig', 'juny', 'juliol', 'agost', 'setembre', 'octubre', 'novembre', 'desembre'],
		temporadas: [
			['Temporada alta', "D'abril a setembre", "La millor època per gaudir de la piscina privada i l'exterior."],
			['Temporada baixa', "D'octubre a març", 'Ideal per a escapades en grup amb llar de foc i tranquil·litat.'],
			['Ponts i festius', 'Setmana Santa, Nadal, ponts', "Consulta la disponibilitat amb antelació: s'omple ràpid per a grups."],
		],
		titulo: 'Preu del lloguer de la casa rural <em>sencera</em>',
		intro: "El lloguer d'Els Porxos és sempre de la casa rural sencera, amb accés exclusiu a la piscina, el jardí, la barbacoa i totes les instal·lacions per al teu grup.",
		incluye: ['Mínim 2 nits', `Fins a ${casa.capacidad} persones`, 'Llençols i tovalloles inclosos', 'Neteja final inclosa'],
		reservar: 'Reserva',
		consulta: 'Envia una consulta',
		anyo: "Temporada alta d'abril a setembre; temporada baixa d'octubre a març",
		aviso: 'Preus per nit per a la casa rural sencera. Consulta els preus exactes per a les dates del teu grup.',
	},
}[lang];
const alta = (i: number) => i >= 3 && i <= 8; // de abril a septiembre
const clases = ['alta', 'baja', 'festivos'];
const temporadas = T.temporadas.map(([nombre, meses, texto], i) => ({ nombre, meses, texto, clase: clases[i] }));
---

<section class="tarifas" id="tarifas" aria-labelledby="tarifas-titulo">
	<div class="envoltorio rejilla">
		<div class="texto">
			<h2 id="tarifas-titulo" class="aparece" set:html={T.titulo} />
			<p class="aparece">{T.intro}</p>
			<ul class="incluye aparece">
				{['moon-stars', 'users', 'bed', 'sparkle'].map((ic, i) => <li><Icono nombre={ic} /> {T.incluye[i]}</li>)}
			</ul>
			<div class="acciones aparece">
				<a class="btn" href={casa.whatsapp} target="_blank" rel="noopener"><Icono nombre="whatsapp-logo" /> {T.reservar}</a>
				<a class="btn btn--linea" href="#contacto">{T.consulta}</a>
			</div>
		</div>

		<div class="temporadas">
			<div class="anyo aparece" role="img" aria-label={T.anyo}>
				{T.meses.map((m, i) => <span class:list={['mes', { 'mes--alta': alta(i) }]} title={T.nombresMeses[i]}>{m}</span>)}
			</div>
			<ul>
				{
					temporadas.map((t) => (
						<li class:list={['temporada', `temporada--${t.clase}`, 'aparece']}>
							<span class="marca" aria-hidden="true" />
							<div>
								<h3>{t.nombre}</h3>
								<p class="meses">{t.meses}</p>
							</div>
							<p class="nota">{t.texto}</p>
						</li>
					))
				}
			</ul>
			<p class="aviso aparece">{T.aviso}</p>
		</div>
	</div>
</section>

<style>
	.tarifas {
		padding-block: var(--seccion);
		background: var(--cal-2);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(2.5rem, 7vw, 8rem);
		align-items: start;
	}
	.texto {
		display: grid;
		gap: var(--s-5);
	}
	h2 {
		max-width: 17ch;
		padding-bottom: 0.08em;
	}
	.incluye {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--s-3) var(--s-5);
		margin: 0;
		padding: 0;
		list-style: none;
		font-weight: 500;
		color: var(--tinta);
	}
	.incluye li {
		display: flex;
		align-items: center;
		gap: var(--s-3);
	}
	.incluye :global(.icono) {
		flex: none;
		width: 24px;
		height: 24px;
		color: var(--oro-texto);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		margin-top: var(--s-2);
	}

	/* Barra del año: los meses de temporada alta en oro */
	.anyo {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 4px;
		margin-bottom: var(--s-6);
	}
	.mes {
		display: grid;
		place-items: end center;
		height: 64px;
		padding-bottom: var(--s-2);
		border-radius: 999px 999px 0 0;
		background: color-mix(in oklch, var(--sec) 22%, transparent);
		font-size: var(--t-xs);
		font-weight: 600;
		color: var(--sec);
	}
	.mes--alta {
		height: 88px;
		align-self: end;
		background: var(--oro);
		color: var(--carbon);
	}
	.anyo {
		align-items: end;
	}

	.temporadas ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.temporada {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.1fr);
		gap: var(--s-5);
		align-items: baseline;
		padding-block: var(--s-5);
		border-top: var(--borde);
	}
	.marca {
		width: 12px;
		height: 16px;
		border-radius: 999px 999px 0 0;
		background: color-mix(in oklch, var(--sec) 35%, transparent);
		transform: translateY(2px);
	}
	.temporada--alta .marca {
		background: var(--oro);
	}
	.temporada--festivos .marca {
		background: transparent;
		border: 1.5px solid var(--oro-texto);
		border-bottom: 0;
	}
	h3 {
		font-size: var(--t-3);
	}
	.meses {
		margin-top: var(--s-1);
		font-size: var(--t-sm);
		font-weight: 600;
		color: var(--oro-texto);
	}
	.nota {
		font-size: var(--t-sm);
		color: var(--sec);
	}
	.aviso {
		padding-top: var(--s-5);
		border-top: var(--borde);
		font-size: var(--t-sm);
		color: var(--sec);
	}

	@media (max-width: 900px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
		.temporada {
			grid-template-columns: auto 1fr;
		}
		.nota {
			grid-column: 2;
		}
		.mes {
			height: 48px;
		}
		.mes--alta {
			height: 64px;
		}
	}
	@media (max-width: 480px) {
		.incluye {
			grid-template-columns: 1fr;
		}
	}
</style>
