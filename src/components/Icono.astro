---
// Iconos de Phosphor (https://phosphoricons.com), insertados como SVG al compilar: cero JS en el navegador.
// Un único grosor en toda la web («light») para que todos los trazos sean iguales.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
	/** Nombre del icono en Phosphor, p. ej. «whatsapp-logo» */
	nombre: string;
	class?: string;
}
const { nombre, class: clase = '' } = Astro.props;
const require = createRequire(import.meta.url);
const svg = readFileSync(require.resolve(`@phosphor-icons/core/light/${nombre}-light.svg`), 'utf8').replace(
	'<svg ',
	`<svg aria-hidden="true" focusable="false" class="icono ${clase}" `,
);
---

<Fragment set:html={svg} />
