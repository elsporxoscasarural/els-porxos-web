---
// Cierre de las páginas interiores: invitación a reservar, sobre carbón.
import Icono from '../Icono.astro';
import { casa } from '../../data/casa';

interface Props {
	titulo: string;
	texto: string;
	/** Segundo botón (secundario) */
	secundario: { texto: string; href: string };
}
const { titulo, texto, secundario } = Astro.props;
---

<section class="llamada sobre-oscuro" aria-labelledby="llamada-titulo">
	<div class="envoltorio rejilla">
		<h2 id="llamada-titulo" class="aparece">{titulo}</h2>
		<div class="lado aparece">
			<p>{texto}</p>
			<div class="acciones">
				<a class="btn btn--claro" href={casa.whatsapp} target="_blank" rel="noopener"><Icono nombre="whatsapp-logo" /> Reservar</a>
				<a class="btn btn--linea-claro" href={secundario.href}>{secundario.texto}</a>
			</div>
		</div>
	</div>
</section>

<style>
	.llamada {
		padding-block: var(--seccion);
		background: var(--carbon);
		color: var(--cal-suave);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: end;
	}
	h2 {
		color: var(--cal);
		max-width: 12ch;
	}
	.lado {
		display: grid;
		gap: var(--s-5);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
	}
	.btn--linea-claro {
		background: transparent;
		color: var(--cal);
		border-color: color-mix(in oklch, var(--cal) 40%, transparent);
	}
	.btn--linea-claro:hover {
		background: transparent;
		border-color: var(--oro);
	}
	@media (max-width: 820px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
	}
</style>
