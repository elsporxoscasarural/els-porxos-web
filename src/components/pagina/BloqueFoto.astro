---
// Bloque de página interior: texto (slot) junto a una foto, que se puede ampliar en el visor.
// «alterna» pone la foto a la derecha; «arco» le da la forma de arco de la marca.
import { Picture } from 'astro:assets';
import type { Foto } from '../../data/fotos';
import { idiomaDe } from '../../i18n';

interface Props {
	foto: Foto;
	alterna?: boolean;
	arco?: boolean;
	fondo?: boolean;
	id?: string;
}
const { foto, alterna = false, arco = false, fondo = false, id } = Astro.props;
const ampliar = idiomaDe(Astro.currentLocale) === 'ca' ? 'Amplia' : 'Ampliar';
---

<section class:list={['bloque', { 'bloque--fondo': fondo }]} id={id}>
	<div class:list={['envoltorio', 'rejilla', { 'rejilla--alterna': alterna }]}>
		<button class:list={['foto', 'aparece', { arco }]} type="button" data-ampliar="casa" data-id={foto.id} aria-label={`${ampliar}: ${foto.alt}`}>
			<Picture formats={['avif', 'webp']} src={foto.src} alt={foto.alt} widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 46vw" />
		</button>
		<div class="texto">
			<slot />
		</div>
	</div>
</section>

<style>
	.bloque {
		padding-block: var(--seccion);
	}
	.bloque--fondo {
		background: var(--cal-2);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: center;
	}
	.rejilla--alterna {
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
	}
	.rejilla--alterna .foto {
		order: 2;
	}
	.foto {
		display: block;
		padding: 0;
		border: 0;
		background: var(--linea);
		overflow: hidden;
		aspect-ratio: 4 / 3.2;
		cursor: zoom-in;
	}
	.foto.arco {
		aspect-ratio: 4 / 4.8;
	}
	.foto :global(picture),
	.foto :global(img) {
		width: 100%;
		height: 100%;
	}
	.foto :global(img) {
		object-fit: cover;
		transition: transform 900ms var(--ease);
	}
	.foto:hover :global(img) {
		transform: scale(1.04);
	}
	.texto {
		display: grid;
		gap: var(--s-5);
		justify-items: start;
	}
	.texto :global(h2) {
		max-width: 15ch;
		padding-bottom: 0.08em;
	}
	.texto :global(ul) {
		display: grid;
		gap: var(--s-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.texto :global(li) {
		position: relative;
		padding-left: 1.4rem;
	}
	.texto :global(li)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.45em;
		width: 9px;
		height: 12px;
		border: 1.5px solid var(--oro);
		border-bottom: 0;
		border-radius: 999px 999px 0 0;
	}
	@media (max-width: 820px) {
		.rejilla,
		.rejilla--alterna {
			grid-template-columns: 1fr;
		}
		.rejilla--alterna .foto {
			order: 0;
		}
		.foto.arco {
			aspect-ratio: 4 / 3.6;
		}
	}
</style>
