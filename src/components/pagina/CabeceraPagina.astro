---
// Cabecera de las páginas interiores: migas de pan, titular, entradilla y una foto en arco.
// El titular va en el slot «titulo» para poder usar <em> (cursiva dorada) en una palabra.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { idiomaDe, ruta } from '../../i18n';

interface Props {
	miga: string;
	entradilla: string;
	foto: ImageMetadata;
	alt: string;
	/** Encuadre de la foto (object-position) */
	encuadre?: string;
}
const { miga, entradilla, foto, alt, encuadre = '50% 50%' } = Astro.props;
const lang = idiomaDe(Astro.currentLocale);
---

<header class="cabecera-pagina">
	<div class="envoltorio rejilla">
		<div class="texto">
			<nav class="migas entra" aria-label={lang === 'ca' ? "Ets a" : 'Estás en'}>
				<ol>
					<li><a href={ruta('/', lang)}>{lang === 'ca' ? 'Inici' : 'Inicio'}</a></li>
					<li aria-current="page">{miga}</li>
				</ol>
			</nav>
			<h1 class="entra"><slot name="titulo" /></h1>
			<p class="entradilla entra">{entradilla}</p>
		</div>
		<div class="foto arco">
			<Picture
				formats={['avif', 'webp']}
				src={foto}
				alt={alt}
				widths={[480, 800, 1200]}
				sizes="(max-width: 820px) 100vw, 44vw"
				loading="eager"
				fetchpriority="high"
				style={`object-position: ${encuadre}`}
			/>
		</div>
	</div>
</header>

<style>
	.cabecera-pagina {
		padding: calc(var(--alto-cabecera) + clamp(2rem, 5vw, 4rem)) 0 var(--seccion);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: end;
	}
	.texto {
		display: grid;
		gap: var(--s-5);
		padding-bottom: var(--s-4);
	}
	.migas ol {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--t-sm);
		color: var(--sec);
	}
	.migas li + li::before {
		content: '›';
		margin-right: var(--s-2);
		color: var(--oro-texto);
	}
	.migas a {
		color: var(--oro-texto);
		font-weight: 600;
		text-decoration: none;
	}
	.migas a:hover {
		text-decoration: underline;
	}
	h1 {
		max-width: 14ch;
		padding-bottom: 0.08em;
	}
	.entradilla {
		max-width: 48ch;
		font-size: var(--t-lead);
	}
	.foto {
		aspect-ratio: 4 / 4.8;
	}
	.foto :global(picture),
	.foto :global(img) {
		width: 100%;
		height: 100%;
	}
	.foto :global(img) {
		object-fit: cover;
	}
	@media (prefers-reduced-motion: no-preference) {
		.entra {
			animation: subir 1s var(--ease) both;
		}
		.entra:nth-child(2) {
			animation-delay: 90ms;
		}
		.entra:nth-child(3) {
			animation-delay: 180ms;
		}
		.foto :global(img) {
			animation: asentar 1.8s var(--ease) both;
		}
	}
	@keyframes subir {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
	}
	@keyframes asentar {
		from {
			transform: scale(1.08);
		}
	}
	@media (max-width: 820px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
		.foto {
			aspect-ratio: 4 / 3.6;
		}
	}
</style>
