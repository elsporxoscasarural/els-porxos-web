---
// Pie común a todas las páginas: logo en claro, navegación y datos legales (registro turístico).
import { Image } from 'astro:assets';
import logoClaro from '../assets/brand/logo-claro.png';
import { casa } from '../data/casa';
import { idiomaDe, ruta } from '../i18n';

const lang = idiomaDe(Astro.currentLocale);
const T = {
	es: {
		enlaces: ['La casa', 'Habitaciones', 'Fotos', 'Tarifas', 'Opiniones', 'Casa rural en Lleida', 'Para grupos grandes', 'Para familias con niños', 'Qué hacer cerca', 'Contacto'],
		inicio: 'inicio', pie: 'Pie de página', casaRural: 'Casa rural en', registro: 'Nº de registro turístico',
	},
	ca: {
		enlaces: ['La casa', 'Habitacions', 'Fotos', 'Tarifes', 'Opinions', 'Casa rural a Lleida', 'Per a grups grans', 'Per a famílies amb nens', 'Què fer a prop', 'Contacte'],
		inicio: 'inici', pie: 'Peu de pàgina', casaRural: 'Casa rural a', registro: 'Núm. de registre turístic',
	},
}[lang];
const destinos = ['/#la-casa', '/#habitaciones', '/#fotos', '/#tarifas', '/#opiniones', '/casa-rural-lleida/', '/casa-rural-grupos-grandes/', '/casa-rural-familias-ninos/', '/que-hacer-cerca/', '/#contacto'];
const enlaces = destinos.map((d, i) => ({ texto: T.enlaces[i], href: ruta(d, lang) }));
const anyo = new Date().getFullYear();
---

<footer class="pie sobre-oscuro">
	<div class="envoltorio rejilla">
		<a class="logo" href={ruta('/', lang)} aria-label={`${casa.nombre}, ${T.inicio}`}>
			<Image src={logoClaro} alt="" width={180} densities={[1, 2]} loading="lazy" />
		</a>
		<nav aria-label={T.pie}>
			<ul>{enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}</ul>
		</nav>
		<div class="datos">
			<p>{T.casaRural} {casa.direccion.localidad}, {lang === 'ca' ? casa.direccion.comarca.replace('La ', 'la ') : casa.direccion.comarca} ({casa.direccion.provincia})</p>
			<p><a href={casa.whatsapp} target="_blank" rel="noopener">WhatsApp {casa.telefono.visible}</a> · <a href={`mailto:${casa.email}`}>{casa.email}</a></p>
		</div>
	</div>
	<div class="envoltorio base">
		<p>© {anyo} {casa.nombre}</p>
		<p>{T.registro}: {casa.registroTuristico}</p>
	</div>
</footer>

<style>
	.pie {
		padding-block: clamp(3.5rem, 7vw, 6rem) var(--s-6);
		background: var(--carbon);
		color: var(--cal-suave);
		font-size: var(--t-sm);
		border-top: 1px solid color-mix(in oklch, var(--cal) 10%, transparent);
	}
	.rejilla {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}
	.logo {
		display: block;
		width: 150px;
	}
	.logo :global(img) {
		width: 100%;
		height: auto;
	}
	nav ul {
		display: grid;
		grid-template-columns: repeat(2, max-content);
		gap: var(--s-2) var(--s-7);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a,
	.datos a {
		color: var(--cal);
		text-decoration: none;
		background: linear-gradient(var(--oro), var(--oro)) 0 100% / 0 1px no-repeat;
		transition: background-size var(--d-media) var(--ease);
	}
	nav a:hover,
	.datos a:hover {
		background-size: 100% 1px;
	}
	.datos {
		display: grid;
		gap: var(--s-2);
		text-align: right;
	}
	.base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--s-3);
		margin-top: clamp(2.5rem, 5vw, 4rem);
		padding-top: var(--s-5);
		border-top: 1px solid color-mix(in oklch, var(--cal) 10%, transparent);
		font-size: var(--t-xs);
	}
	@media (max-width: 900px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
		.datos {
			text-align: left;
		}
	}
</style>
