---
// Logos de marcas (Simple Icons, https://simpleicons.org), insertados como SVG al compilar.
// Se pintan con currentColor para que sigan la paleta de la web.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
	/** Nombre en Simple Icons, p. ej. «airbnb», «bookingdotcom» */
	nombre: string;
	class?: string;
}
const { nombre, class: clase = '' } = Astro.props;
const require = createRequire(import.meta.url);
const svg = readFileSync(require.resolve(`simple-icons/icons/${nombre}.svg`), 'utf8').replace(
	'<svg ',
	`<svg aria-hidden="true" focusable="false" fill="currentColor" class="marca-logo ${clase}" `,
);
---

<Fragment set:html={svg} />
