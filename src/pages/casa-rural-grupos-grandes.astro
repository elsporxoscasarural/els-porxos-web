---
// Página «Casa rural para grupos grandes» (SEO): búsquedas de grupos grandes, 18-20 personas,
// grupos de amigos y celebraciones en Lleida y Cataluña. Contenido propio, no repetido de otras páginas.
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/pagina/CabeceraPagina.astro';
import BloqueFoto from '../components/pagina/BloqueFoto.astro';
import Rasgos from '../components/pagina/Rasgos.astro';
import Distancias from '../components/pagina/Distancias.astro';
import LlamadaFinal from '../components/pagina/LlamadaFinal.astro';
import Preguntas from '../components/inicio/Preguntas.astro';
import Visor from '../components/Visor.astro';
import Icono from '../components/Icono.astro';
import { foto } from '../data/fotos';
import { esquemaPreguntas, type Pregunta } from '../data/preguntas';
import { migas, paginaSobreLaCasa } from '../data/esquema';

const url = 'https://elsporxos.es/casa-rural-grupos-grandes/';
const titulo = 'Casa rural para grupos grandes en Lleida · Hasta 19 personas · Els Porxos';
const descripcion =
	'Casa rural para grupos grandes en Lleida: alquiler de la casa entera para hasta 19 personas, con 6 habitaciones, piscina privada, barbacoa y una mesa para comer todos juntos. Ideal para grupos de amigos y celebraciones, a 1 h 50 min de Barcelona.';

const comer = [
	{ icono: 'campfire', titulo: 'Barbacoa de obra', texto: 'Bajo el porche cubierto, con una mesa larga donde cabe todo el grupo para comer y cenar al aire libre.' },
	{ icono: 'fork-knife', titulo: 'Salón-comedor para todos', texto: 'Una gran mesa de madera, sofás de cuero y chimenea para las sobremesas y las noches de invierno.' },
	{ icono: 'cooking-pot', titulo: 'Cocina completa', texto: 'Nevera, horno, vitrocerámica, microondas, lavavajillas y menaje para cocinar para todo el grupo.' },
	{ icono: 'swimming-pool', titulo: 'Piscina privada', texto: 'Solo para vuestro grupo, rodeada de jardín y con acceso directo desde los porches.' },
	{ icono: 'soccer-ball', titulo: 'Pista con porterías', texto: 'Una pista privada con dos porterías para los partidos del grupo, a cualquier hora.' },
	{ icono: 'ping-pong', titulo: 'Futbolín y ping-pong', texto: 'Bajo el porche, para los ratos entre la piscina y la barbacoa.' },
];

const preguntas: Pregunta[] = [
	{
		pregunta: '¿Para cuántas personas es la casa?',
		respuesta:
			'Para un máximo de 19 personas, que es la capacidad oficial registrada (HUTL-000401). Funciona igual de bien para grupos de 10, 12 o 15 personas: siempre se alquila la casa entera.',
	},
	{
		pregunta: '¿Podemos celebrar un cumpleaños o una reunión de empresa?',
		respuesta:
			'Sí, celebraciones tranquilas dentro del grupo alojado: cumpleaños, aniversarios, reuniones familiares o de empresa. La única condición es no poner música alta por la noche.',
	},
	{
		pregunta: '¿Cómo nos repartimos en las habitaciones?',
		respuesta:
			'Hay 2 habitaciones de matrimonio (una es suite con baño), 2 dobles con camas individuales, 1 triple y 1 séxtuple con literas, y 3 baños completos en total.',
	},
	{
		pregunta: '¿Cuántas noches hay que reservar?',
		respuesta:
			'El mínimo es de 2 noches. El precio es por la casa completa e incluye sábanas, toallas y la limpieza final.',
	},
];

const esquema = [paginaSobreLaCasa(url, titulo, descripcion), migas('Casa rural para grupos grandes', url), esquemaPreguntas(preguntas)];
---

<BaseLayout title={titulo} description={descripcion}>
	{esquema.map((b) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(b)} />)}

	<CabeceraPagina
		miga="Casa rural para grupos grandes"
		entradilla="Els Porxos se alquila siempre entera: seis habitaciones, piscina privada y un porche con barbacoa donde comer todos juntos, en Bellcaire d'Urgell (Lleida). Para grupos de amigos, familias grandes y celebraciones de hasta 19 personas."
		foto={foto('barbacoa-mesa-porche').src}
		alt={foto('barbacoa-mesa-porche').alt}
	>
		<Fragment slot="titulo">Casa rural para <em>grupos grandes</em> en Lleida</Fragment>
	</CabeceraPagina>

	<BloqueFoto foto={foto('salon-comedor-mesa')} fondo>
		<h2 class="aparece">Hasta 19 personas bajo <em>el mismo techo</em></h2>
		<p class="aparece">
			Cuando el grupo es grande, lo difícil es encontrar una casa donde quepáis todos sin repartiros en varios
			alojamientos. En Els Porxos dormís todos en la misma casa, con sitio de sobra en las zonas comunes.
		</p>
		<ul class="aparece">
			<li>2 habitaciones de matrimonio, una de ellas suite con baño</li>
			<li>2 habitaciones dobles con camas individuales</li>
			<li>1 habitación triple</li>
			<li>1 habitación séxtuple con literas</li>
			<li>3 baños completos</li>
		</ul>
	</BloqueFoto>

	<Rasgos id="rasgos-titulo" items={comer} entradilla="La casa está pensada para pasar el día juntos: se cocina, se come y se juega en los mismos espacios, sin que nadie se quede aparte.">
		<Fragment slot="titulo">Pensada para estar <em>todos juntos</em></Fragment>
	</Rasgos>

	<BloqueFoto foto={foto('porche-futbolin-piscina')} alterna arco fondo>
		<h2 class="aparece">Cumpleaños, aniversarios y <em>reuniones</em></h2>
		<p class="aparece">
			Muchos grupos vienen a celebrar algo: un cumpleaños redondo, un aniversario, la reunión anual de la familia o
			unos días de equipo con la empresa. Los porches cubiertos y el jardín dan sitio para una comida larga, y la
			piscina y la pista llenan las horas de después.
		</p>
		<p class="aparece">
			Se admiten celebraciones tranquilas dentro del grupo alojado, sin música alta por la noche: la casa está en un
			pueblo y se respeta el descanso de los vecinos.
		</p>
	</BloqueFoto>

	<BloqueFoto foto={foto('porche-ping-pong')}>
		<h2 class="aparece">Un fin de semana con <em>amigos</em> en Lleida</h2>
		<p class="aparece">
			Viernes de barbacoa, sábado de piscina y partido en la pista, y si os apetece salir: kayak en el embalse de
			Camarasa, las pasarelas del Congost de Mu, el Congost de Mont-rebei o una cata de vinos en el Castell del
			Remei, a 15 minutos.
		</p>
		<a class="btn btn--linea aparece" href="/que-hacer-cerca/">Qué hacer cerca <Icono nombre="arrow-right" class="flecha" /></a>
	</BloqueFoto>

	<section class="llegar" aria-labelledby="llegar-titulo">
		<div class="envoltorio rejilla">
			<div>
				<h2 id="llegar-titulo" class="aparece">A menos de dos horas de <em>Barcelona</em></h2>
				<p class="aparece">
					Bellcaire d'Urgell está en la llanura de Urgell, en la comarca de La Noguera. Se llega por autovía y
					carretera desde Barcelona, Lleida, Tarragona, Zaragoza y Andorra: un buen punto de encuentro para grupos que
					vienen de sitios distintos. La casa tiene aparcamiento gratuito.
				</p>
			</div>
			<div class="aparece"><Distancias /></div>
		</div>
	</section>

	<Preguntas lista={preguntas} />

	<LlamadaFinal
		titulo="Reserva la casa para tu grupo"
		texto="Dinos cuántos sois y las fechas, y te respondemos con disponibilidad y precio para la casa completa."
		secundario={{ texto: 'Ver la casa', href: '/#la-casa' }}
	/>
	<Visor />
</BaseLayout>

<style>
	.llegar {
		padding-block: var(--seccion);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: center;
	}
	.llegar h2 {
		max-width: 14ch;
		padding-bottom: 0.08em;
		margin-bottom: var(--s-5);
	}
	@media (max-width: 820px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
	}
</style>
