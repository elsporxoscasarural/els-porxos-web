---
// Página «Casa rural en Lleida» (SEO). Mismo título, descripción, textos y datos estructurados
// que la versión anterior: no se pierde posicionamiento.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/pagina/CabeceraPagina.astro';
import LlamadaFinal from '../components/pagina/LlamadaFinal.astro';
import Icono from '../components/Icono.astro';
import Visor from '../components/Visor.astro';
import { casa } from '../data/casa';
import { foto } from '../data/fotos';
import esquema from '../data/esquema-casa-rural-lleida.json';

const portada = foto('fachada-jardin-entrada');
const pingPong = foto('porche-ping-pong');
const piscina = foto('piscina-seto');
const camino = foto('jardin-camino-entrada');
const galeria = ['porche-arcos-jardin', 'salon-comedor-mesa', 'pista-deportiva', 'habitacion-d-suite', 'porche-futbolin-piscina'].map(foto);

const cifras = [
	{ n: casa.capacidad, t: 'Huéspedes' },
	{ n: casa.habitaciones, t: 'Habitaciones' },
	{ n: casa.banos, t: 'Baños' },
	{ n: 2, t: 'Plantas' },
];
const incluye = [
	{ icono: 'swimming-pool', titulo: 'Piscina privada', texto: 'Piscina de uso exclusivo para el grupo, rodeada de jardín. Ideal para los meses de verano en Lleida.' },
	{ icono: 'campfire', titulo: 'Barbacoa y porches', texto: 'Barbacoa equipada bajo los arcos del porche, con una gran mesa para comer todos juntos al aire libre.' },
	{ icono: 'soccer-ball', titulo: 'Zona deportiva', texto: 'Pista de fútbol con porterías, futbolín y mesa de ping-pong. Los niños y los no tan niños no pararán.' },
	{ icono: 'basketball', titulo: 'Zona de juegos infantil', texto: 'Canasta, casita, tobogán y columpio dentro del recinto vallado de la casa rural. Seguro para los pequeños.' },
	{ icono: 'fire', titulo: 'Chimenea', texto: 'El salón tiene chimenea para las noches de invierno. Una casa rural en Lleida para disfrutar todo el año.' },
	{ icono: 'cooking-pot', titulo: 'Cocina completa', texto: 'Nevera, horno, vitrocerámica, microondas, lavavajillas y utensilios para cocinar para todo el grupo.' },
];
---

<BaseLayout
	title="Casa rural en Lleida para grupos · Els Porxos · Piscina privada, hasta 19 personas"
	description="Busca una casa rural en Lleida para grupos? Els Porxos en Bellcaire d'Urgell: alquiler completo para hasta 19 personas con piscina privada, barbacoa, jardín y zona de juegos. Ideal para familias y amigos."
>
	{esquema.map((bloque) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(bloque)} />)}

	<CabeceraPagina
		miga="Casa rural en Lleida"
		entradilla="Els Porxos es una casa rural de alquiler completo en Bellcaire d'Urgell, comarca de La Noguera (Lleida). Con capacidad para hasta 19 personas, piscina privada y un extenso jardín con porches, es el alojamiento rural ideal para escapadas en grupo en la provincia de Lleida."
		foto={portada.src}
		alt={portada.alt}
		encuadre="28% 50%"
	>
		<Fragment slot="titulo">Casa rural en Lleida para <em>grupos y familias</em></Fragment>
	</CabeceraPagina>

	<section class="grupos" aria-labelledby="grupos-titulo">
		<div class="envoltorio">
			<h2 id="grupos-titulo" class="aparece">Una casa rural en Lleida pensada para <em>grupos grandes</em></h2>
			<div class="parrafos aparece">
				<p>
					Si buscas una casa rural en Lleida donde quepan todos, Els Porxos es tu sitio. Con 6 habitaciones, 3 baños y
					dos plantas completas, puedes venir con tu grupo de amigos, tu familia extendida o tu equipo de trabajo y tener
					espacio de sobra.
				</p>
				<p>
					La casa se alquila siempre completa, sin compartir con otros huéspedes. La piscina, el jardín, la barbacoa, la
					pista de fútbol y todas las instalaciones son solo para vuestro grupo durante toda la estancia.
				</p>
			</div>
			<dl class="cifras">
				{cifras.map((c) => <div class="aparece"><dt>{c.n}</dt><dd>{c.t}</dd></div>)}
			</dl>
		</div>
	</section>

	<section class="incluye" aria-labelledby="incluye-titulo">
		<div class="envoltorio rejilla">
			<div class="incluye__foto arco aparece">
				<Picture formats={['avif', 'webp']} src={pingPong.src} alt={pingPong.alt} widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 36vw" />
			</div>
			<div>
				<h2 id="incluye-titulo" class="aparece">Todo lo que incluye el alquiler de esta casa rural en <em>Lleida</em></h2>
				<ul class="lista">
					{
						incluye.map((i) => (
							<li class="aparece">
								<Icono nombre={i.icono} />
								<h3>{i.titulo}</h3>
								<p>{i.texto}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="partida" aria-labelledby="piscina-titulo">
		<div class="envoltorio partida__rejilla">
			<div class="partida__foto aparece">
				<Picture formats={['avif', 'webp']} src={piscina.src} alt={piscina.alt} widths={[640, 960, 1440]} sizes="(max-width: 820px) 100vw, 56vw" />
			</div>
			<div class="partida__texto">
				<h2 id="piscina-titulo" class="aparece">Piscina privada y jardín <em>solo para vosotros</em></h2>
				<p class="aparece">
					Una de las mejores cosas de alquilar una casa rural en Lleida con piscina es no compartirla con nadie. En Els
					Porxos, la piscina es de uso exclusivo para el grupo que alquila la casa. Está rodeada de jardín con seto,
					árboles y flores, y tiene acceso directo desde los porches.
				</p>
				<p class="aparece">
					El jardín es amplio y seguro: los niños pueden jugar libremente en la zona infantil mientras los adultos
					disfrutan de la barbacoa y el sol. El recinto está completamente vallado.
				</p>
			</div>
		</div>
	</section>

	<section class="partida partida--alterna" aria-labelledby="ubicacion-titulo">
		<div class="envoltorio partida__rejilla">
			<div class="partida__foto arco aparece">
				<Picture formats={['avif', 'webp']} src={camino.src} alt={camino.alt} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 40vw" />
			</div>
			<div class="partida__texto">
				<h2 id="ubicacion-titulo" class="aparece">En Bellcaire d'Urgell, <em>comarca de La Noguera</em></h2>
				<p class="aparece">
					Bellcaire d'Urgell es un pueblo tranquilo de la llanura de Urgell, en la provincia de Lleida. Está a 30 minutos
					de Balaguer, 45 de Lleida capital y con fácil acceso por la C-12 y la C-26. Desde aquí puedes visitar el
					Congost de Mont-rebei, las pasarelas del Congost de Mu, el embalse de Camarasa, el Estany d'Ivars y los murales
					de Penelles.
				</p>
				<p class="aparece">
					Es el punto de partida perfecto para combinar descanso rural con excursiones por la naturaleza de Lleida, sin
					salir de una zona de campos, canales y pueblos con encanto.
				</p>
				<a class="btn btn--linea aparece" href="/que-hacer-cerca/">Descubre qué hacer cerca <Icono nombre="arrow-right" class="flecha" /></a>
			</div>
		</div>
	</section>

	<section class="galeria" aria-labelledby="galeria-titulo">
		<div class="envoltorio">
			<div class="galeria__cabeza">
				<h2 id="galeria-titulo" class="aparece">Conoce la casa rural por dentro y por <em>fuera</em></h2>
				<a class="btn btn--linea aparece" href="/#fotos">Ver todas las fotos</a>
			</div>
			<div class="mosaico">
				{
					galeria.map((f, i) => (
						<button class:list={['celda', `celda--${i}`, 'aparece']} type="button" data-ampliar="casa" data-id={f.id} aria-label={`Ampliar: ${f.alt}`}>
							<Picture formats={['avif', 'webp']} src={f.src} alt={f.alt} widths={[400, 800]} sizes="(max-width: 820px) 50vw, 33vw" />
						</button>
					))
				}
			</div>
		</div>
	</section>

	<LlamadaFinal
		titulo="Reserva tu casa rural en Lleida"
		texto="Consulta disponibilidad y precios para tu grupo. El alquiler mínimo es de 2 noches e incluye sábanas, toallas y limpieza final."
		secundario={{ texto: 'Enviar formulario', href: '/#contacto' }}
	/>
	<Visor />
</BaseLayout>

<style>
	.grupos {
		padding-block: var(--seccion);
		background: var(--cal-2);
	}
	.grupos h2 {
		max-width: 16ch;
		padding-bottom: 0.08em;
	}
	.parrafos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--s-6);
		margin-top: var(--s-6);
		max-width: 64rem;
	}
	.cifras {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: clamp(3rem, 6vw, 5rem) 0 0;
		border-top: var(--borde);
	}
	.cifras div {
		padding: var(--s-5) var(--s-4) 0 0;
	}
	.cifras div + div {
		padding-left: var(--s-5);
		border-left: var(--borde);
	}
	.cifras dt {
		font: 500 clamp(3rem, 7vw, 6rem) / 1 var(--f-display);
		color: var(--tinta);
	}
	.cifras dd {
		margin: var(--s-1) 0 0;
		color: var(--oro-texto);
		font-weight: 600;
	}

	.incluye {
		padding-block: var(--seccion);
	}
	.rejilla {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
	}
	.incluye__foto {
		position: sticky;
		top: calc(var(--alto-cabecera) + var(--s-6));
		aspect-ratio: 3 / 4;
	}
	.incluye__foto :global(img),
	.partida__foto :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.incluye__foto :global(picture),
	.partida__foto :global(picture) {
		display: block;
		height: 100%;
	}
	.incluye h2 {
		max-width: 15ch;
		padding-bottom: 0.08em;
	}
	.lista {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--s-7) var(--s-6);
		margin: var(--s-7) 0 0;
		padding: 0;
		list-style: none;
	}
	.lista li {
		display: grid;
		gap: var(--s-2);
		padding-top: var(--s-5);
		border-top: var(--borde);
	}
	.lista :global(.icono) {
		width: 30px;
		height: 30px;
		color: var(--oro-texto);
	}
	.lista p {
		font-size: var(--t-sm);
		color: var(--sec);
	}

	.partida {
		padding-block: var(--seccion);
	}
	.partida:not(.partida--alterna) {
		background: var(--cal-2);
	}
	.partida__rejilla {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: center;
	}
	.partida--alterna .partida__rejilla {
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
	}
	.partida__foto {
		aspect-ratio: 16 / 11;
	}
	.partida--alterna .partida__foto {
		aspect-ratio: 4 / 5;
	}
	.partida__texto {
		display: grid;
		gap: var(--s-5);
		justify-items: start;
	}
	.partida__texto h2 {
		max-width: 14ch;
		padding-bottom: 0.08em;
	}

	.galeria {
		padding-block: var(--seccion);
	}
	.galeria__cabeza {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: var(--s-5);
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}
	.galeria h2 {
		max-width: 16ch;
		padding-bottom: 0.08em;
	}
	.mosaico {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		grid-auto-rows: clamp(10rem, 17vw, 15rem);
		gap: clamp(0.6rem, 1.2vw, 1rem);
	}
	.celda {
		padding: 0;
		border: 0;
		background: var(--linea);
		overflow: hidden;
		cursor: zoom-in;
	}
	.celda :global(picture),
	.celda :global(img) {
		width: 100%;
		height: 100%;
	}
	.celda :global(img) {
		object-fit: cover;
		transition: transform 900ms var(--ease);
	}
	.celda:hover :global(img) {
		transform: scale(1.05);
	}
	.celda--0 {
		grid-column: span 2;
		grid-row: span 2;
		border-radius: 9999px 9999px 0 0;
	}

	@media (max-width: 820px) {
		.parrafos,
		.rejilla,
		.partida__rejilla,
		.partida--alterna .partida__rejilla {
			grid-template-columns: 1fr;
		}
		.cifras {
			grid-template-columns: repeat(2, 1fr);
		}
		.cifras div:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
		.incluye__foto {
			position: static;
			aspect-ratio: 4 / 3;
		}
		.lista {
			grid-template-columns: 1fr;
			gap: var(--s-5);
		}
		.mosaico {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
